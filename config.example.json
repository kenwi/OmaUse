{
  "enabled": true,
  "flux": {
    "enabled": false,
    "announce-hostname": false
  },
  "ignore": [
    "/run/media/*"
  ],
  "log": {
    "enabled": false,
    "path": "~/.local/state/omause/quiet.log",
    "locale": "en",
    "format": "short"
  },
  "thresholds": [
    {
      "percent": 80
    },
    {
      "percent": 90
    },
    {
      "percent": 100,
      "drive": "/pool",
      "script": "/home/USER/.config/omause/cleanup-pool.sh"
    }
  ]
}
